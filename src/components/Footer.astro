---
import type { Lang } from '../lib/constants';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<footer class="foot">
  <div class="wrap foot-in">
    <span class="brand">Kelana</span>
    <span>{t('ft.name')}</span>
    <span>{t('ft.note')}</span>
  </div>
</footer>
